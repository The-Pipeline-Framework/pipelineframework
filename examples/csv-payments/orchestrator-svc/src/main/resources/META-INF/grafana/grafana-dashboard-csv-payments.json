{
  "uid": "csv-payments-dashboard",
  "title": "CSV Payments — Telemetry Proof",
  "schemaVersion": 41,
  "version": 2,
  "tags": ["csv-payments", "telemetry-proof"],
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Proof profile",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 4 },
      "options": { "mode": "markdown", "content": "This dashboard proves the **telemetry-capable CSV Payments developer profile**: Quarkus tracing and Micrometer/Prometheus metrics are available, TPF telemetry is enabled, and OTLP traces route to the LGTM stack. The self-host profile intentionally disables telemetry and is not a proof target.\n\nMetrics use only low-cardinality stage, Await step/transport, outcome, target, and provider dimensions." }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "End-to-end semantic-stage throughput",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(tpf_pipeline_run_count_total[$__rate_interval]))", "legendFormat": "pipeline run" },
        { "refId": "B", "expr": "sum(rate(tpf_orchestrator_transition_dispatched_transitions_total[$__rate_interval]))", "legendFormat": "transition dispatched" },
        { "refId": "C", "expr": "sum by (tpf_await_step_id, tpf_await_transport) (rate(tpf_await_interaction_created_interactions_total[$__rate_interval]))", "legendFormat": "Await interaction created {{tpf_await_step_id}}/{{tpf_await_transport}}" },
        { "refId": "D", "expr": "sum by (tpf_await_step_id, tpf_await_transport) (rate(tpf_await_interaction_dispatched_interactions_total[$__rate_interval]))", "legendFormat": "provider dispatch {{tpf_await_step_id}}/{{tpf_await_transport}}" },
        { "refId": "E", "expr": "sum by (tpf_await_step_id, tpf_await_transport) (rate(tpf_await_completion_admitted_completions_total[$__rate_interval]))", "legendFormat": "completion admitted {{tpf_await_step_id}}/{{tpf_await_transport}}" },
        { "refId": "F", "expr": "sum by (tpf_await_step_id, tpf_await_transport) (rate(tpf_await_live_handoff_handoffs_total[$__rate_interval]))", "legendFormat": "live handoff {{tpf_await_step_id}}/{{tpf_await_transport}}" },
        { "refId": "G", "expr": "sum by (tpf_await_step_id, tpf_await_transport) (rate(tpf_await_scalar_continuation_started_continuations_total[$__rate_interval]))", "legendFormat": "scalar continuation {{tpf_await_step_id}}/{{tpf_await_transport}}" },
        { "refId": "H", "expr": "sum by (tpf_object_publish_target, tpf_object_publish_provider) (rate(tpf_object_publish_published_objects_total[$__rate_interval]))", "legendFormat": "terminal publication {{tpf_object_publish_target}}/{{tpf_object_publish_provider}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Await completion latency — p50, p90, p99",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le, tpf_await_step_id, tpf_await_transport) (rate(tpf_await_completion_latency_milliseconds_bucket[$__rate_interval])))", "legendFormat": "p50 {{tpf_await_step_id}}/{{tpf_await_transport}}" },
        { "refId": "B", "expr": "histogram_quantile(0.90, sum by (le, tpf_await_step_id, tpf_await_transport) (rate(tpf_await_completion_latency_milliseconds_bucket[$__rate_interval])))", "legendFormat": "p90 {{tpf_await_step_id}}/{{tpf_await_transport}}" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le, tpf_await_step_id, tpf_await_transport) (rate(tpf_await_completion_latency_milliseconds_bucket[$__rate_interval])))", "legendFormat": "p99 {{tpf_await_step_id}}/{{tpf_await_transport}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Queue and Await backpressure",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "sum by (tpf_await_step_id, tpf_await_transport) (tpf_await_admission_pending_reservations)", "legendFormat": "Await reservations {{tpf_await_step_id}}/{{tpf_await_transport}}" },
        { "refId": "B", "expr": "tpf_orchestrator_transition_active_ratio", "legendFormat": "transition worker active" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Await routes, rejects, and timeouts",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "sum by (tpf_await_step_id, tpf_await_transport) (increase(tpf_await_live_handoff_handoffs_total[$__range]))", "legendFormat": "live handoff {{tpf_await_step_id}}/{{tpf_await_transport}}" },
        { "refId": "B", "expr": "sum by (tpf_await_step_id, tpf_await_transport) (increase(tpf_await_resume_released_resumes_total[$__range]))", "legendFormat": "durable fallback resume {{tpf_await_step_id}}/{{tpf_await_transport}}" },
        { "refId": "C", "expr": "sum by (tpf_await_transport, tpf_await_completion_reason) (increase(tpf_await_completion_dropped_events_total[$__range]))", "legendFormat": "dropped {{tpf_await_transport}}/{{tpf_await_completion_reason}}" },
        { "refId": "D", "expr": "sum by (tpf_await_step_id, tpf_await_status) (increase(tpf_await_unit_terminal_units_total[$__range]))", "legendFormat": "terminal {{tpf_await_step_id}}/{{tpf_await_status}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Terminal publication outcomes and p95 write latency",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "sum by (tpf_object_publish_target, tpf_object_publish_provider) (increase(tpf_object_publish_published_objects_total[$__range]))", "legendFormat": "success {{tpf_object_publish_target}}/{{tpf_object_publish_provider}}" },
        { "refId": "B", "expr": "sum by (tpf_object_publish_target, tpf_object_publish_provider) (increase(tpf_object_publish_failed_objects_total[$__range]))", "legendFormat": "failure {{tpf_object_publish_target}}/{{tpf_object_publish_provider}}" },
        { "refId": "C", "expr": "histogram_quantile(0.95, sum by (le, tpf_object_publish_target, tpf_object_publish_provider) (rate(tpf_object_publish_write_duration_milliseconds_bucket[$__rate_interval])))", "legendFormat": "p95 {{tpf_object_publish_target}}/{{tpf_object_publish_provider}}" }
      ]
    }
  ]
}
