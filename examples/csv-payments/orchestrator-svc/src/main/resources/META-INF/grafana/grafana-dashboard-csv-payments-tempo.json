{
  "uid": "csv-payments-tempo-proof",
  "title": "CSV Payments — Await Trace Proof",
  "schemaVersion": 41,
  "version": 2,
  "tags": ["csv-payments", "tempo", "telemetry-proof"],
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Trace proof profile",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 4 },
      "options": { "mode": "markdown", "content": "This dashboard is bound to the **telemetry-capable CSV Payments developer profile**. It requires tracing capability and OTLP routing to Tempo. The self-host container profile, which intentionally disables telemetry, is validated as disabled and must not be used for this proof.\n\nA live boundary preserves parent/child context. A durable boundary may start a new physical trace only when its semantic span carries an OpenTelemetry link to the durable origin; the final panel exposes accidental rootless Await continuation spans." }
    },
    {
      "id": 2,
      "type": "traces",
      "title": "Pipeline and transition dispatch",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "queryType": "traceql", "query": "{ name = \"tpf.pipeline.run\" } || { name = \"tpf.transition.dispatched\" }" }
      ]
    },
    {
      "id": 3,
      "type": "traces",
      "title": "Await creation and provider admission/dispatch",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "queryType": "traceql", "query": "{ name = \"tpf.await.interaction.created\" } || { name = \"tpf.await.provider.dispatch\" } || { name = \"tpf.await.provider.admitted\" }" }
      ]
    },
    {
      "id": 4,
      "type": "traces",
      "title": "Completion admission and live handoff",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "queryType": "traceql", "query": "{ name = \"tpf.await.completion.admitted\" } || { name = \"tpf.await.live.handoff\" }" }
      ]
    },
    {
      "id": 5,
      "type": "traces",
      "title": "Scalar continuation and terminal publication",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "queryType": "traceql", "query": "{ name = \"tpf.await.scalar.continuation\" } || { name = \"tpf.terminal.publication.completed\" }" }
      ]
    },
    {
      "id": 6,
      "type": "traces",
      "title": "Disconnected/rootless Await-journey diagnostic",
      "description": "Any result is a conformance failure: the completion span lacks both continued parentage and the durable origin link.",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 },
      "targets": [
        { "refId": "A", "queryType": "traceql", "query": "{ name = \"tpf.await.completion.admitted\" && span[\"tpf.await.origin.linked\"] = false }" }
      ]
    }
  ]
}
