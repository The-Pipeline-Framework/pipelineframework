{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipelineframework.org/schemas/system-tests/compatibility-set-v1.json",
  "title": "TPF coordinated compatibility set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "candidates"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {"$ref": "candidate-event.schema.json"}
    }
  }
}
