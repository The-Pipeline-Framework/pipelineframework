{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipelineframework.org/schemas/system-tests/compatibility-candidate-manifest-v1.json",
  "title": "TPF dependency-ordered compatibility candidate manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "setId", "repository", "component", "sourceSha", "baseSha", "testedSha", "pullRequestNumber", "candidateVersion", "dependencyOverrides", "provenance", "mavenArtifacts"],
  "properties": {
    "schemaVersion": {"const": 1},
    "setId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "repository": {"type": "string", "pattern": "^The-Pipeline-Framework/[A-Za-z0-9._-]+$"},
    "component": {"type": "string", "minLength": 1},
    "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "baseSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "testedSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pullRequestNumber": {"type": "integer", "minimum": 1},
    "candidateVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-pr\\.[1-9][0-9]*\\.[0-9a-f]{12}$"},
    "dependencyOverrides": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+=\\S+$"}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "sha", "runId", "runAttempt", "workflowPath"],
      "properties": {
        "repository": {"const": "The-Pipeline-Framework/pipelineframework"},
        "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "runId": {"type": "integer", "minimum": 1},
        "runAttempt": {"type": "integer", "minimum": 1},
        "workflowPath": {"const": ".github/workflows/system-test-compatibility-set.yml"}
      }
    },
    "mavenArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["groupId", "artifactId", "version", "packaging", "files"],
        "properties": {
          "groupId": {"type": "string", "minLength": 1},
          "artifactId": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "packaging": {"enum": ["jar", "pom", "maven-plugin"]},
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "sha256"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
