<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.pipelineframework</groupId>
        <artifactId>framework-parent</artifactId>
        <version>26.9.4-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>pipelineframework-bom</artifactId>
    <packaging>pom</packaging>
    <name>The Pipeline Framework BOM</name>
    <description>Tested compatible versions of TPF contracts, compiler, runtime, connectors, Blocks, and Expansions.</description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <configuration>
                    <flattenMode>bom</flattenMode>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <!-- Shared model, DSL, API, serialization, protocol, and runtime contracts. -->
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>pipelineframework-api</artifactId>
                <version>${pipelineframework.contracts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>pipelineframework-dsl</artifactId>
                <version>${pipelineframework.contracts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>representation-provider-api</artifactId>
                <version>${pipelineframework.contracts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>pipelineframework-runtime-api</artifactId>
                <version>${pipelineframework.contracts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>pipelineframework-runtime-core</artifactId>
                <version>${pipelineframework.contracts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>pipelineframework-runtime-protocol</artifactId>
                <version>${pipelineframework.contracts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>pipelineframework-runtime-serialization</artifactId>
                <version>${pipelineframework.contracts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>pipelineframework-runtime-spi</artifactId>
                <version>${pipelineframework.contracts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>pipelineframework-semantic-model</artifactId>
                <version>${pipelineframework.contracts.version}</version>
            </dependency>

            <!-- Host-neutral compiler. -->
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>pipelineframework-compiler</artifactId>
                <version>${pipelineframework.compiler.version}</version>
            </dependency>

            <!-- Customer runtimes and foundational plugins. -->
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>pipelineframework</artifactId>
                <version>${pipelineframework.runtime.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>pipelineframework-deployment</artifactId>
                <version>${pipelineframework.runtime.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>pipelineframework-runtime-spring</artifactId>
                <version>${pipelineframework.runtime.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>persistence-plugin</artifactId>
                <version>${pipelineframework.runtime.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>cache-plugin</artifactId>
                <version>${pipelineframework.runtime.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>repository-plugin</artifactId>
                <version>${pipelineframework.runtime.version}</version>
            </dependency>

            <!-- Connector contracts, providers, and host integrations. -->
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>connector-import-tooling</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>embedding-query-connector</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>embedding-query-langchain4j-connector</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>gmail-query-connector</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>graphql-connector</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>graphql-smallrye-connector</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>host-gmail</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>host-microsoft-graph</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>host-oidc-quarkus</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>host-quickbooks-mcp</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>http-contract</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>http-connector</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>llm-query-connector</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>llm-query-langchain4j-connector</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>mcp-contract</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>mcp-connector</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>object-ingest-connector</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>query-hibernate-common</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>query-hibernate-reactive-connector</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>query-jpa-connector</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>representation-provider-file</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>representation-provider-http</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>representation-provider-opencsv</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>vector-store-connector</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework</groupId>
                <artifactId>vector-store-pgvector-connector</artifactId>
                <version>${pipelineframework.connectors.version}</version>
            </dependency>

            <!-- Reusable compile-time Blocks. -->
            <dependency>
                <groupId>org.pipelineframework.blocks</groupId>
                <artifactId>document-text-extraction</artifactId>
                <version>${pipelineframework.blocks.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework.blocks</groupId>
                <artifactId>graphql</artifactId>
                <version>${pipelineframework.blocks.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework.blocks</groupId>
                <artifactId>graphql-agent</artifactId>
                <version>${pipelineframework.blocks.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework.blocks</groupId>
                <artifactId>openapi-representation-mapper</artifactId>
                <version>${pipelineframework.blocks.version}</version>
            </dependency>

            <!-- Version-aligned Expansion distributions. -->
            <dependency>
                <groupId>org.pipelineframework.expansions</groupId>
                <artifactId>graphql</artifactId>
                <version>${pipelineframework.expansions.version}</version>
                <type>pom</type>
            </dependency>
            <dependency>
                <groupId>org.pipelineframework.expansions</groupId>
                <artifactId>openapi</artifactId>
                <version>${pipelineframework.expansions.version}</version>
                <type>pom</type>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
