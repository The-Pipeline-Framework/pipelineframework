{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipelineframework.org/schemas/system-tests/candidate-manifest-v1.json",
  "title": "TPF candidate manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "component", "sourceSha", "pullRequestNumber", "candidateVersion", "workflow", "mavenArtifacts", "images"],
  "properties": {
    "schemaVersion": {"const": 1},
    "repository": {"type": "string"},
    "component": {"type": "string"},
    "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pullRequestNumber": {"type": ["integer", "null"], "minimum": 1},
    "candidateVersion": {"type": "string"},
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "runId", "runAttempt", "workflowRef"],
      "properties": {
        "repository": {"type": "string"},
        "runId": {"type": "integer", "minimum": 1},
        "runAttempt": {"type": "integer", "minimum": 1},
        "workflowRef": {"type": "string", "minLength": 1}
      }
    },
    "mavenArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["groupId", "artifactId", "version", "packaging", "files"],
        "properties": {
          "groupId": {"type": "string", "minLength": 1},
          "artifactId": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "packaging": {"enum": ["jar", "pom", "maven-plugin"]},
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "sha256"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "digest"],
        "properties": {
          "repository": {"type": "string", "pattern": "^ghcr\\.io/"},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
