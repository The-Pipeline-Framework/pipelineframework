{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipelineframework.org/schemas/system-tests/compatibility-set-v1.json",
  "title": "TPF coordinated compatibility set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "requests"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "repository", "repositoryName", "pullRequestNumber", "url"],
        "properties": {
          "component": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "pattern": "^The-Pipeline-Framework/[A-Za-z0-9._-]+$"},
          "repositoryName": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "pullRequestNumber": {"type": "integer", "minimum": 1},
          "url": {"type": "string", "pattern": "^https://github\\.com/The-Pipeline-Framework/[A-Za-z0-9._-]+/pull/[1-9][0-9]*$"}
        }
      }
    },
    "stackRevision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stackSnapshot": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["repository", "rootPullRequestNumber", "rootBaseRef", "layers"],
        "properties": {
          "repository": {"type": "string", "pattern": "^The-Pipeline-Framework/[A-Za-z0-9._-]+$"},
          "rootPullRequestNumber": {"type": "integer", "minimum": 1},
          "rootBaseRef": {"type": "string", "minLength": 1},
          "layers": {
            "type": "array", "minItems": 1, "maxItems": 50,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["number", "headSha", "headRef", "baseRef"],
              "properties": {
                "number": {"type": "integer", "minimum": 1},
                "headSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "headRef": {"type": "string", "minLength": 1},
                "baseRef": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"requests": {"maxItems": 1}}},
     "then": {"required": ["stackSnapshot", "stackRevision"],
              "properties": {"stackSnapshot": {"contains": {"properties": {"layers": {"minItems": 2}}}}}}}
  ],
  "dependentRequired": {
    "stackSnapshot": ["stackRevision"], "stackRevision": ["stackSnapshot"]
  }
}
