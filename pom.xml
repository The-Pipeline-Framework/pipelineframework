<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.pipelineframework</groupId>
    <artifactId>pipeline-framework-root</artifactId>
    <version>26.9.4-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>The Pipeline Framework - Root POM</name>
    <description>The root POM for the Pipeline Framework project and its framework tooling</description>
    <url>https://pipelineframework.org/</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>mbarcia</id>
            <name>Mariano E. Barcia</name>
            <url>https://github.com/mbarcia</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/The-Pipeline-Framework/pipelineframework.git</connection>
        <developerConnection>scm:git:git@github.com:The-Pipeline-Framework/pipelineframework.git</developerConnection>
        <url>https://github.com/The-Pipeline-Framework/pipelineframework</url>
        <tag>v26.9.2</tag>
    </scm>

    <properties>
        <pipelineframework.contracts.version>26.9.4-SNAPSHOT</pipelineframework.contracts.version>
        <pipelineframework.compiler.version>26.9.4-SNAPSHOT</pipelineframework.compiler.version>
        <pipelineframework.runtime.version>26.9.4-SNAPSHOT</pipelineframework.runtime.version>
        <pipelineframework.connectors.version>26.9.4-SNAPSHOT</pipelineframework.connectors.version>
        <pipelineframework.blocks.version>26.9.4-SNAPSHOT</pipelineframework.blocks.version>
        <pipelineframework.expansions.version>26.9.4-SNAPSHOT</pipelineframework.expansions.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <spotless.plugin.version>2.44.0</spotless.plugin.version>
        <compile.testing.version>0.23.0</compile.testing.version>
        <junit.version>6.1.3</junit.version>
        <maven.deploy.skip>true</maven.deploy.skip>
        <skipTests>false</skipTests>
        <skipUnitTests>false</skipUnitTests>
    </properties>

    <repositories>
        <repository>
            <id>central-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>always</updatePolicy>
            </snapshots>
        </repository>
    </repositories>

    <modules>
        <module>framework</module>
    </modules>

    <build>
        <defaultGoal>clean install</defaultGoal>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.1</version>
                    <configuration>
                        <skip>${skipUnitTests}</skip>
                        <skipTests>${skipTests}</skipTests>
                        <forkCount>1</forkCount>
                        <reuseForks>true</reuseForks>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.plugin.version}</version>
                    <configuration>
                        <java>
                            <eclipse>
                                <file>${maven.multiModuleProjectDirectory}/ide-config/quarkus-formatter.xml</file>
                            </eclipse>
                            <removeUnusedImports />
                            <formatAnnotations />
                            <endWithNewline />
                        </java>
                        <formats>
                            <format>
                                <includes>
                                    <include>src/main/**/*.java</include>
                                    <include>src/test/**/*.java</include>
                                </includes>
                            </format>
                        </formats>
                    </configuration>
                    <executions>
                        <execution>
                            <!-- Runs in compile phase to fail fast in case of formatting issues.-->
                            <id>spotless-check</id>
                            <phase>package</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
