{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TPF independent stable product selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "productVersion", "previousVersion", "components", "testHarnesses"],
  "properties": {
    "schemaVersion": {"const": 1},
    "productVersion": {"$ref": "#/$defs/version"},
    "previousVersion": {"anyOf": [{"$ref": "#/$defs/version"}, {"type": "null"}]},
    "validationRunId": {"type": "integer", "minimum": 1},
    "components": {
      "type": "object",
      "required": ["contracts", "compiler", "cli", "runtime", "connectors", "blocks", "expansions"],
      "properties": {
        "contracts": {"$ref": "#/$defs/component"},
        "compiler": {"$ref": "#/$defs/component"},
        "cli": {"$ref": "#/$defs/component"},
        "runtime": {"$ref": "#/$defs/component"},
        "connectors": {"$ref": "#/$defs/component"},
        "blocks": {"$ref": "#/$defs/component"},
        "expansions": {"$ref": "#/$defs/component"}
      },
      "additionalProperties": false
    },
    "testHarnesses": {
      "type": "object",
      "required": ["examples", "references", "csvPayments", "ragTurnkey"],
      "properties": {
        "examples": {"$ref": "#/$defs/source"},
        "references": {"$ref": "#/$defs/source"},
        "csvPayments": {"$ref": "#/$defs/source"},
        "ragTurnkey": {"$ref": "#/$defs/source"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["repository", "sha"],
      "properties": {"repository": {"type": "string"}, "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "sha", "mavenVersion", "release"],
      "properties": {
        "repository": {"type": "string"},
        "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "mavenVersion": {"$ref": "#/$defs/version"},
        "release": {"enum": ["new", "reuse"]}
      }
    }
  }
}
